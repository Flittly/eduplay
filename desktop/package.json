{
  "name": "eduplay-desktop",
  "version": "1.5.2",
  "description": "EduPlay 老师端桌面壳：启动本地 Java 后端并打开原生窗口",
  "main": "main.js",
  "portableDirName": "EduPlay-便携版",
  "portableDataDirName": "EduPlay-用户数据（请勿删除）",
  "author": "EduPlay",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win dir -c.directories.output=release-portable && node scripts/rename-portable.js",
    "dist:portable:32": "electron-builder --win dir --ia32 --config electron-builder-32.yml && node scripts/rename-portable.js --arch ia32",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.eduplay.desktop",
    "productName": "EduPlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "ball.html"
    ],
    "extraResources": [
      {
        "from": "../backend/target/eduplay-backend.jar",
        "to": "app.jar"
      },
      {
        "from": "build/ball-logo.png",
        "to": "ball-logo.png"
      },
      {
        "from": "runtime",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduPlay"
    },
    "toolsets": {
      "winCodeSign": "0.0.0"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "icon": "build/icon.ico"
  }
}
